# No dependency here needs an install script, and one of them would run anyway:
# better-sqlite3 (v13+) ships prebuilt binaries in `prebuilds/` and loads those,
# but still has a binding.gyp, and npm runs `node-gyp rebuild` for any package
# with a binding.gyp and no install script. That compiles nothing yet needs
# `make`, and failed the production deploy on a host without it. The root
# pnpm-workspace.yaml makes the same call for the app (`allowBuilds`).
ignore-scripts=true
